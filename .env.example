# Copy this file to .env before running Docker Compose.
# These credentials are for a local-only demonstration. Change them before any shared deployment.
POSTGRES_DB=business_ai
POSTGRES_USER=business_ai
POSTGRES_PASSWORD=change-me-local-only

# The app and MLflow use this shared PostgreSQL instance in the Compose setup.
DATABASE_URL=postgresql+psycopg://business_ai:change-me-local-only@db:5432/business_ai
MLFLOW_TRACKING_URI=http://mlflow:5000
LANGGRAPH_CHECKPOINT_PATH=/app/data/checkpoints.sqlite
MODEL_ARTIFACT_DIR=/app/artifacts/models

# Optional natural-language adviser. The deterministic prototype works without Ollama.
# Install Ollama separately, pull a model, then set AGENT_LLM_PROVIDER=ollama.
AGENT_LLM_PROVIDER=none
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# Demo data and API settings
AUTO_SEED_DEMO=true
API_BASE_URL=http://api:8000
